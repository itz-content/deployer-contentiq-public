# Optional: copy to .env.sm (gitignored) and run ./render-pipelinerun-from-env.sh.
# You can skip this file entirely and use `tkn pipeline start ... -p KEY=...` or a local PipelineRun YAML.
# Never commit .env.sm — it holds instance URL and secret IDs.
#
# One Secrets Manager instance; three arbitrary secret UUIDs (same as `ibmcloud secrets-manager secret --id`).
#
# Use `export` on each value so a plain `source tekton/.env.sm` passes variables to child processes
# (e.g. ansible-playbook reads SECRETS_MANAGER_* via lookup('env')). Alternatively: set -a; source …; set +a.

export SECRETS_MANAGER_ENDPOINT_URL=https://afa20521-cd75-4864-843f-e59fd0ffd49d.us-south.secrets-manager.appdomain.cloud
export BACKEND_SECRET_KEY_ID=83eec62f-23d7-80d3-de6c-f7aa48c3ec4e
export RAG_SECRET_KEY_ID=3520bb5f-9050-8928-e812-67ed3c959fa8
export REGISTRY_SECRET_KEY_ID=3ede12f0-7c8a-fd86-d245-197d064641f9

# Optional overrides (defaults match pipeline)
# TARGET_NAMESPACE=contentiq
# REGISTRY_PAYLOAD_FORMAT=json-stringdata
# BACKEND_PAYLOAD_FORMAT=json-stringdata
# Dotenv-style SM payload (KEY=value, # comments), often base64-wrapped in SM:
# BACKEND_PAYLOAD_FORMAT=env-stringdata
# BACKEND_PAYLOAD_BASE64=true
# RAG_PAYLOAD_FORMAT=kubernetes-yaml
# BACKEND_PAYLOAD_BASE64=false
# RAG_PAYLOAD_BASE64=true
# REGISTRY_PAYLOAD_BASE64=false
# Legacy: BACKEND_RAG_PAYLOAD_FORMAT=... still honored by render-pipelinerun-from-env.sh for both if set.
# ROLLOUT_RESTART=true
