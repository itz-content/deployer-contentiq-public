apiVersion: v1
kind: Secret
metadata:
  name: {{ contentiq_rag_secret_name }}
  namespace: {{ contentiq_namespace }}
type: Opaque
stringData:
{% if contentiq_install_rag_secret_resolved | default({}) %}
{% for item in (contentiq_install_rag_secret_resolved | default({})) | dictsort %}
  {{ item.0 }}: {{ item.1 | string | quote }}
{% endfor %}
{% else %}
  PLACEHOLDER: "External secrets not yet wired"
{% endif %}
